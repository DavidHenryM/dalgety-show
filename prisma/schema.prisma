// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../app/generated/prisma"
  previewFeatures = ["relationJoins"]
  engineType      = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]

  firstName                   String?
  lastName                    String?
  username                    String?         @unique
  Authenticator               Authenticator[]
  mobileNumber                String?
  landlineNumber              String?
  billingAddressId            String?         @unique
  billingAddress              Address?        @relation(name: "UserBillingAddress", fields: [billingAddressId], references: [id])
  shippingAddressId           String?         @unique
  shippingAddress             Address?        @relation(name: "UserShippingAddress", fields: [shippingAddressId], references: [id])
  addressid                   Int?
  organisation                Organisation[]
  role                        Role            @default(USER)
  chiefStewardOfEventSections EventSection[]  @relation(name: "eventSectionChiefSteward")
  stewardOfEventSections      EventSection[]
  eventResults                EventResult[]
  memberships                 Membership[]
  officialRole                OfficialRole?

  dataEdits DataEdit[]

  @@unique([email])
  @@map("user")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Account {
  id           String    @id @default(cuid())
  userId       String
  providerId   String
  accountId    String
  accessToken  String?
  refreshToken String?   @db.Text
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String

  @@unique([providerId, accountId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model DataEdit {
  id         String         @id @default(cuid())
  table      String
  field      String
  operation  DATA_OPERATION
  editedBy   User           @relation(fields: [editedById], references: [id])
  editedById String
  editedAt   DateTime       @default(now())
}

model Address {
  id           String        @id @default(cuid())
  unit         Int?
  streetNumber Int
  streetName   String
  streetType   String
  suburb       String
  state        State
  country      String
  postCode     Int
  billingUser  User?         @relation(name: "UserBillingAddress")
  shippingUser User?         @relation(name: "UserShippingAddress")
  billingOrg   Organisation? @relation(name: "OrgBillingAddress")
  shippingOrg  Organisation? @relation(name: "OrgShippingAddress")
}

model Organisation {
  id                String        @id @default(cuid())
  name              String        @unique
  billingAddress    Address?      @relation(name: "OrgBillingAddress", fields: [billingAddressId], references: [id])
  billingAddressId  String?       @unique
  shippingAddress   Address?      @relation(name: "OrgShippingAddress", fields: [shippingAddressId], references: [id])
  shippingAddressId String?       @unique
  contactPerson     User          @relation(fields: [contactPersonId], references: [id])
  contactPersonId   String        
  sponsorships      Sponsorship[]
}

model EventSection {
  id                        String                    @id @default(cuid())
  name                      String
  image                     String?
  description               String?
  details                   String?                   @db.Text
  entryInstructions         String?                   @db.Text
  entryEmail                String?
  letter                    String?
  eventSectionSponsorshipId Int?
  eventSectionSponsorships  EventSectionSponsorship[]
  events                    Event[]
  show                      Show                      @relation(fields: [showId], references: [id])
  showId                    String
  chiefStewardId            String?
  chiefSteward              User?                     @relation(name: "eventSectionChiefSteward", fields: [chiefStewardId], references: [id])
  stewards                  User[]
  entryClose                DateTime?
  itemDeliveryStart         DateTime?
  itemDeliveryEnd           DateTime?
}

model Event {
  id           String        @id @unique @default(cuid())
  name         String
  description  String?
  image        String?
  section      EventSection  @relation(fields: [sectionId], references: [id])
  sectionId    String
  show         Show          @relation(fields: [showId], references: [id])
  showId       String
  results      EventResult[]
  maximumAge   Int?
  minimumAge   Int?
  gender       Gender        @default(OPEN)
  entryFee     Float?
  entryFeeTeam Float?
  prizes       Prize[]
}

model EventResult {
  id      String  @id @unique @default(cuid())
  prize   Prize?
  prizeId String?
  event   Event   @relation(fields: [eventId], references: [id])
  eventId String
  winner  User[]
}

model Prize {
  id             String       @id @default(cuid())
  prizeName      String?
  cashPrizeValue Float?
  trophyName     String?
  ribbonName     String?
  eventResultId  String?      @unique
  eventResult    EventResult? @relation(fields: [eventResultId], references: [id])
  event          Event        @relation(fields: [eventId], references: [id])
  eventId        String
}

model EventSectionSponsorship {
  id           String        @id @default(cuid())
  sectionId    String        @unique
  section      EventSection  @relation(fields: [sectionId], references: [id])
  amount       Float
  sponsorships Sponsorship[]
}

model Schedule {
  id         String     @id @default(cuid())
  show       Show       @relation(fields: [showId], references: [id])
  showId     String     @unique
  released   DateTime?
  activities Activity[]
}

model Activity {
  id          String   @id @default(cuid())
  time        DateTime
  name        String
  description String?
  link        String?
  icon        String?
  schedule    Schedule @relation(fields: [scheduleId], references: [id])
  scheduleId  String
}

model Sponsorship {
  id             String                    @id @default(cuid())
  package        SponsorshipPackage        @relation(fields: [packageId], references: [id])
  packageId      String
  totalAmount    Float
  section        EventSectionSponsorship[]
  showId         String
  show           Show                      @relation(fields: [showId], references: [id])
  organisation   Organisation              @relation(fields: [organisationId], references: [id])
  organisationId String
}

model Show {
  id      String   @id @default(cuid())
  year    Int      @unique
  number  Int
  tagLine String
  start   DateTime
  finish  DateTime
  events  Event[]

  eventSections EventSection[]
  sponsorships  Sponsorship[]
  schedule      Schedule?
}

model Membership {
  id        String         @id @default(cuid())
  member    User           @relation(fields: [memberId], references: [id])
  memberId  String
  startDate DateTime?
  renewDate DateTime?
  type      MembershipType @default(INDIVIDUAL)
  cost      Float
  paidDate  DateTime?
  applyDate DateTime
}

model MembershipPackage {
  id        String         @id @default(cuid())
  type      MembershipType
  cost      Float
  validFrom DateTime
  validTo   DateTime?
  termDays  Int
}

model SponsorshipPackage {
  id            String                 @id @default(cuid())
  tier          SponsorshipPackageTier
  minimumAmount Int
  maximumAmount Int
  sponsorships  Sponsorship[]
}

enum DATA_OPERATION {
  CREATE
  UPDATE
  DELETE
}

enum State {
  ACT
  NSW
  QLD
  VIC
  SA
  NT
  WA
  TAS
}

enum Role {
  SITE_ADMIN
  USER
  OWNER
}

enum SponsorshipPackageTier {
  PLATNIUM
  GOLD
  SILVER
  BRONZE
  SECTION
}

enum SponsorshipSection {
  WOODCHOP
  HORSE_ARENA
  NOVELTY_EVENT
  YARD_DOG_TRIALS
  STOCKMANS_CHALLENGE
  SECTION_C_STUD_CATTLE
  SECTION_B_MERINO_SHEEP
  SECTION_B1_MERINO_WOOL
  SECTION_C1_COMMERCIAL_CATTLE
  JUNIOR_JUDGING_CATTLE
  SECTION_P_POULTRY
  SECTION_D_FRESH_PRODUCE
}

enum Gender {
  WOMEN
  MEN
  OPEN
}

enum OfficialRole {
  PRESIDENT
  VICE_PRESIDENT
  SECRETARY
  ENTRY_SECRETARY
  TREASURER
  PUBLICITY_OFFICER
  STALL_COORDINATOR
}

enum MembershipType {
  INDIVIDUAL
  FAMILY
}
